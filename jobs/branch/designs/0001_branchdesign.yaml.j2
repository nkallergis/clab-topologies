---
locations:
  - "!create_or_update:name": "{{ site_name }}"
    status__name: "Active"
    location_type__name: "Site"
    parent__name: "{{ region.name }}"

    prefixes:
      - "!create_or_update:prefix": "{{ site_prefix }}"
        status__name: "Active"

    devices:
    # ----- Routers -----
    {% for i in range(2) %}
      - "!create_or_update:name": "{{ site_name }}-RTR{{ i }}"
        status__name: "Active"
        device_type__model: "Dummy"
        role__name: "Router"
        platform__name: "Arista EOS"
        "!ref": "{{ site_name }}-RTR{{ i }}"
        interfaces:
          - "!create_or_update:name": "eth1"
            type: "1000base-t"
            description: "Uplink to backbone"
            status__name: "Active"
            "!ref": "{{ site_name }}-RTR{{ i }}:eth1"
          - "!create_or_update:name": "eth2"
            type: "1000base-t"
            description: "Downlink to SW0"
            status__name: "Active"
            "!ref": "{{ site_name }}-RTR{{ i }}:eth2"
          - "!create_or_update:name": "eth3"
            type: "1000base-t"
            description: "Downlink to SW1"
            status__name: "Active"
            "!ref": "{{ site_name }}-RTR{{ i }}:eth3"
    {% endfor %}

    # ----- Switches -----
    {% for i in range(2) %}
      - "!create_or_update:name": "{{ site_name }}-SW{{ i }}"
        status__name: "Active"
        device_type__model: "Dummy"
        role__name: "Switch"
        platform__name: "Arista EOS"
        "!ref": "{{ site_name }}-SW{{ i }}"
        interfaces:
          - "!create_or_update:name": "eth1"
            type: "1000base-t"
            description: "Uplink to RTR0"
            status__name: "Active"
            "!ref": "{{ site_name }}-SW{{ i }}:eth1"
          - "!create_or_update:name": "eth2"
            type: "1000base-t"
            description: "Uplink to RTR1"
            status__name: "Active"
            "!ref": "{{ site_name }}-SW{{ i }}:eth2"
    {% endfor %}

cables:
  - "!create_or_update:termination_a": "!ref:{{ site_name }}-RTR0:eth1"
    "!create_or_update:termination_b": "!ref:{{ site_name }}-RTR1:eth1"
    status__name: "Connected"
  - "!create_or_update:termination_a": "!ref:{{ site_name }}-RTR0:eth2"
    "!create_or_update:termination_b": "!ref:{{ site_name }}-SW0:eth1"
    status__name: "Connected"
  - "!create_or_update:termination_a": "!ref:{{ site_name }}-RTR0:eth3"
    "!create_or_update:termination_b": "!ref:{{ site_name }}-SW1:eth1"
    status__name: "Connected"
  - "!create_or_update:termination_a": "!ref:{{ site_name }}-RTR1:eth2"
    "!create_or_update:termination_b": "!ref:{{ site_name }}-SW0:eth2"
    status__name: "Connected"
  - "!create_or_update:termination_a": "!ref:{{ site_name }}-RTR1:eth3"
    "!create_or_update:termination_b": "!ref:{{ site_name }}-SW1:eth2"
    status__name: "Connected"

dynamic_groups:
  - "!create_or_update:name": "{{ site_name }}"
    "description": "Dynamic Group for the devices in location {{ site_name }}"
    content_type:
      "!get:model": "device"
      "!get:app_label": "dcim"
    filter: {"location": ["{{ site_name }}"]} 
    
circuits:
  {% for i in range(2) %}
  - cid: "{{ site_name }}-CKT-{{ i }}"
    status__name: "Active"
    provider__name: "NTC"
    circuit_type__name: "Ethernet"
    circuit_terminations:
      - term_side: "A"
        location__name: "{{ site_name }}"
      - term_side: "Z"
        provider_network__name: "NTC-WAN"
  {% endfor %}
