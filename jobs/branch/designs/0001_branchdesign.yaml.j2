---
locations:
  - "!create_or_update:name": "{{ site_name }}"
    status__name: "Active"
    location_type__name: "Site"
    parent__name: "{{ region.name }}"

    prefixes:
      - "!create_or_update:prefix": "{{ site_prefix }}"
        status__name: "Active"

    devices:
    # ----- Routers -----
    {% for rtr in range(1, 3) %}
      - "!create_or_update:name": "{{ site_name }}-RTR{{ rtr }}"
        status__name: "Active"
        device_type__model: "Dummy"
        role__name: "Router"
        platform__name: "Arista EOS"
        "!ref": "{{ site_name }}-RTR{{ rtr }}"
        interfaces:
          - "!create_or_update:name": "eth8"
            type: "1000base-t"
            description: "Uplink to backbone"
            status__name: "Active"
            "!ref": "{{ site_name }}-RTR{{ rtr }}:eth8"
          {% for port in range(1, 3) %}
          - "!create_or_update:name": "eth{{ port }}"
            type: "1000base-t"
            description: "Downlink to {{ site_name }}-SW{{ port }}"
            status__name: "Active"
            "!ref": "{{ site_name }}-RTR{{ rtr }}:eth{{ port }}"
          {% endfor %}
    {% endfor %}

    # ----- Switches -----
    {% for sw in range(1, 3) %}
      - "!create_or_update:name": "{{ site_name }}-SW{{ sw }}"
        status__name: "Active"
        device_type__model: "Dummy"
        role__name: "Switch"
        platform__name: "Arista EOS"
        "!ref": "{{ site_name }}-SW{{ sw }}"
        interfaces:
        {% for port in range(1, 3) %}
          - "!create_or_update:name": "eth{{ port }}"
            type: "1000base-t"
            description: "Uplink to RTR{{ port }}"
            status__name: "Active"
            "!connect_cable":
              to: "!ref:{{ site_name }}-RTR{{ port }}:eth{{ sw }}"
              status__name: "Active"
        {% endfor %}
    {% endfor %}

dynamic_groups:
  - "!create_or_update:name": "{{ site_name }}"
    "description": "Dynamic Group for the devices in location {{ site_name }}"
    content_type:
      "!get:model": "device"
      "!get:app_label": "dcim"
    filter: {"location": ["{{ site_name }}"]} 
    
circuits:
  {% for i in range(1, 3) %}
  - cid: "{{ site_name }}-CKT-{{ i }}"
    status__name: "Active"
    provider__name: "NTC"
    circuit_type__name: "Ethernet"
    circuit_terminations:
      - term_side: "A"
        location__name: "{{ site_name }}"
      - term_side: "Z"
        provider_network__name: "NTC-WAN"
  {% endfor %}
